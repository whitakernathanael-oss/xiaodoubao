{
  "name": "doubao-autoskin",
  "productName": "小豆包",
  "version": "0.1.21",
  "description": "Local theme editor for the Doubao Windows client",
  "author": "Doubao AutoSkin Contributors",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "make": "electron-forge make --arch=x64",
    "release:win": "npm run typecheck && npm test && node tools/release-win.cjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@types/node": "^26.2.0",
    "electron": "43.3.0",
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
